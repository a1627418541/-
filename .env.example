# ==========================================
# Virtual Girlfriend - Environment Variables
# ==========================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Configuration
# Use unified AI configs (preferred) or legacy Kimi configs (backward compat)

# Unified AI config (supports any OpenAI-compatible API, including Cloudflare AI Gateway)
AI_PROVIDER=kimi
AI_API_KEY=your_api_key_here
# Set this to your Cloudflare AI Gateway endpoint to proxy requests
AI_BASE_URL=
AI_MODEL=moonshot-v1-128k
AI_TEMPERATURE=0.7

# Image Generation (DashScope Wanxiang / 通义万相)
# Get API key from: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# Legacy Kimi configs (used as fallback if AI_* vars are empty)
KIMI_API_KEY=your_api_key_here
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# Crisp Chat (injected into frontend, this is a public ID)
CRISP_WEBSITE_ID=your-crisp-website-id

# Cloudflare R2 (Object Storage for generated images)
# Get credentials from: https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public URL for accessing R2 objects (e.g. https://pub-xxx.r2.dev or your custom domain)
R2_PUBLIC_URL=https://pub-yourid.r2.dev

# Resend (Email service)
RESEND_API_KEY=your-resend-api-key

# Cron (Daily love letter)
CRON_SECRET=your-cron-secret

# Node environment
NODE_ENV=development
